{
  "name": "lean4-copilot",
  "displayName": "lean4-copilot",
  "description": "LLM powered lean4 code assistant",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:lean4Copilot.completeProof",
    "onCommand:lean4Copilot.inlineSuggest",
    "onCommand:lean4Copilot.applyProposed",
    "onCommand:lean4Copilot.discardProposed",
    "onLanguage:lean4"
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "lean4Copilot.applyProposed",
        "key": "enter",
        "when": "resourceScheme == lean4copilot && textInputFocus"
      },
      {
        "command": "lean4Copilot.discardProposed",
        "key": "escape",
        "when": "resourceScheme == lean4copilot && textInputFocus"
      }
    ],
    "commands": [
      {
        "command": "lean4Copilot.applyProposed",
        "title": "Accept Copilot Changes",
        "icon": "$(check)"
      },
      {
        "command": "lean4Copilot.discardProposed",
        "title": "Discard Copilot Changes",
        "icon": "$(close)"
      },
      {
        "command": "lean4Copilot.completeProof",
        "title": "Lean4 Copilot: Complete Proof"
      },
      {
        "command": "lean4Copilot.inlineSuggest",
        "title": "Lean4 Copilot: Ghost Suggest"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lean4Copilot.applyProposed",
          "when": "resourceScheme == 'lean4copilot'",
          "group": "navigation@100"
        },
        {
          "command": "lean4Copilot.discardProposed",
          "when": "resourceScheme == 'lean4copilot'",
          "group": "navigation@101"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ext": "vscode-test --extensionDevelopmentPath=. --extensionTestsPath=./out/src/test",
    "test": "npm run test:unit && npm run test:ext"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/ui": "^3.2.4",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^5.2.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
